<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">My applications</h1>
    <span class="text-body-secondary"><%= applications.length %> application<%= applications.length === 1 ? "" : "s" %></span>
</div>

<% if (typeof errorMessage !== "undefined") { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
<% } %>

<% if (applications.length === 0 && typeof errorMessage === "undefined") { %>
    <div class="text-center text-body-secondary py-5 my-auto">
        <i class="bi bi-file-earmark-text fs-1 d-block mb-2"></i>
        You haven't applied to any jobs yet.
        <div class="mt-3"><a href="/jobs" class="btn btn-warning">Browse jobs</a></div>
    </div>
<% } %>

<% if (applications.length > 0) { %>
    <%
        const statusColors = {
            applied: "text-bg-secondary",
            shortlisted: "text-bg-info",
            rejected: "text-bg-danger",
            accepted: "text-bg-success",
        };
    %>
    <div class="card shadow-lg">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Job</th>
                        <th>Salary</th>
                        <th>Applied on</th>
                        <th>Resume</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% applications.forEach(function (application) { %>
                        <% const job = application.jobId; %>
                        <tr>
                            <td>
                                <% if (job) { %>
                                    <div class="d-flex align-items-center gap-3">
                                        <% if (job.companyLogoUrl) { %>
                                            <img src="<%= job.companyLogoUrl %>" alt="<%= job.companyName %> logo" class="table-logo">
                                        <% } else { %>
                                            <div class="table-logo d-flex align-items-center justify-content-center fw-bold text-body-secondary">
                                                <%= job.companyName.charAt(0) %>
                                            </div>
                                        <% } %>
                                        <div>
                                            <div class="fw-semibold"><%= job.jobTitle %></div>
                                            <div class="small text-body-secondary"><%= job.companyName %></div>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <span class="text-body-secondary">This job was removed</span>
                                <% } %>
                            </td>
                            <td><%= job && job.salary ? "₹ " + job.salary.toLocaleString("en-IN") : "-" %></td>
                            <td><%= new Date(application.appliedAt).toLocaleDateString("en-IN") %></td>
                            <td>
                                <% if (application.resumePath) { %>
                                    <a href="/applications/<%= application._id %>/resume" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                <% } else { %>
                                    <span class="text-body-secondary small">-</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge <%= statusColors[application.status] || 'text-bg-secondary' %> text-capitalize">
                                    <%= application.status %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>
