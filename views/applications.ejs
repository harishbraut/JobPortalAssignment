<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">Applications for my jobs</h1>
    <span class="text-body-secondary"><%= applications.length %> application<%= applications.length === 1 ? "" : "s" %></span>
</div>

<% if (typeof errorMessage !== "undefined") { %>
    <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
<% } %>

<% if (applications.length === 0 && typeof errorMessage === "undefined") { %>
    <div class="text-center text-body-secondary py-5 my-auto">
        <i class="bi bi-people fs-1 d-block mb-2"></i>
        Nobody has applied to your jobs yet.
    </div>
<% } %>

<% if (applications.length > 0) { %>
    <% const statuses = ["applied", "shortlisted", "rejected", "accepted"]; %>
    <div class="card shadow-lg">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Applicant</th>
                        <th>Email</th>
                        <th>Job</th>
                        <th>Applied on</th>
                        <th>Resume</th>
                        <th style="width: 180px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% applications.forEach(function (application) { %>
                        <tr>
                            <td class="fw-semibold">
                                <%= application.applicantId ? application.applicantId.username : "Deleted user" %>
                            </td>
                            <td><%= application.applicantId ? application.applicantId.email : "-" %></td>
                            <td>
                                <% if (application.jobId) { %>
                                    <%= application.jobId.jobTitle %>
                                    <div class="small text-body-secondary"><%= application.jobId.companyName %></div>
                                <% } else { %>
                                    <span class="text-body-secondary">Deleted job</span>
                                <% } %>
                            </td>
                            <td><%= new Date(application.appliedAt).toLocaleDateString("en-IN") %></td>
                            <td>
                                <% if (application.resumePath) { %>
                                    <a href="/applications/<%= application._id %>/resume" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-download me-1"></i> Download
                                    </a>
                                <% } else { %>
                                    <span class="text-body-secondary small">No resume</span>
                                <% } %>
                            </td>
                            <td>
                                <select class="form-select form-select-sm status-select text-capitalize"
                                        aria-label="Application status"
                                        data-job-id="<%= application.jobId ? application.jobId._id : '' %>"
                                        data-application-id="<%= application._id %>"
                                        data-current="<%= application.status %>"
                                        <%= application.jobId ? "" : "disabled" %>>
                                    <% statuses.forEach(function (status) { %>
                                        <option value="<%= status %>" <%= status === application.status ? "selected" : "" %>><%= status %></option>
                                    <% }) %>
                                </select>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<div class="toast-container position-fixed top-0 end-0 p-3 mt-5">
    <div id="statusToast" class="toast align-items-center border-0" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="statusToastText"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
    const toastElement = document.getElementById("statusToast");

    function showToast(text, success) {
        document.getElementById("statusToastText").textContent = text;
        toastElement.classList.toggle("text-bg-success", success);
        toastElement.classList.toggle("text-bg-danger", !success);
        bootstrap.Toast.getOrCreateInstance(toastElement).show();
    }

    document.querySelectorAll(".status-select").forEach(function (select) {
        select.addEventListener("change", async function () {
            const { jobId, applicationId, current } = select.dataset;
            const newStatus = select.value;
            select.disabled = true;

            try {
                // Same API as in Postman: POST /jobs/:jobId/:applicationId with { status }
                const response = await fetch(`/jobs/${jobId}/${applicationId}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ status: newStatus }),
                });
                const data = await response.json();

                if (response.ok) {
                    select.dataset.current = newStatus;
                    showToast(`Status changed to "${newStatus}"`, true);
                } else {
                    select.value = current;   // put the old value back
                    showToast(data.message, false);
                }
            } catch (error) {
                select.value = current;
                showToast("Could not reach the server. Please try again.", false);
            }

            select.disabled = false;
        });
    });
</script>
